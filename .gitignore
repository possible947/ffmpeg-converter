# Build artifacts
/build/
/bin/
*/build/
!fpc/build/
!fpc/build/Makefile
!fpc/build/fpmake.pp
!fpc/build/package_macos_app.sh

# Bundled ffmpeg/ffprobe source binaries (placed in project root for packaging)
/ffmpeg
/ffprobe

# Pascal compiled units and intermediate files
*.ppu
*.ppu.bak
*.compiled
fpc/*/lib/

# Built GUI binaries (not the .app bundles)
fpc/gui/ffmpeg_converter_gui
fpc/cli/ffmpeg_converter

# Generated app bundles (packaged artifacts)
fpc/gui/form.app/
fpc/gui/ffmpeg_converter_gui.app/

# Generated dylib dependency/queue files (produced by package_macos_app.sh)
src/platform/macos/bin/

# Object files
*.o
*.obj

# Libraries
*.so
*.dylib
*.dll

# Executables
*.exe
*.out

# macOS metadata
.DS_Store

# Logs and temporary
*.log
*.tmp
*~
*.swp

# IDE/editor
.vscode/
.idea/
/.cache/

# Coverage
coverage/
