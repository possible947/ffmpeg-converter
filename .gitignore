# Build artifacts
/build/
/bin/
*/build/
!fpc/build/
!fpc/build/Makefile
!fpc/build/fpmake.pp
!fpc/build/package_macos_app.sh

# Bundled ffmpeg/ffprobe source binaries (stored in src/platform/macos/bin/)
src/platform/macos/bin/ffmpeg
src/platform/macos/bin/ffprobe
src/platform/linux/bin/ffmpeg
src/platform/linux/bin/ffprobe

# Local agent/project metadata
AGENTS.md

# Pascal compiled units and intermediate files
*.ppu
*.ppu.bak
*.compiled
fpc/*/lib/

# Built GUI/CLI binaries (not the .app bundles)
fpc/gui/ffmpeg_converter_gui
fpc/cli/ffmpeg_converter

# Pascal compiled test binaries
fpc/test/test_*
fpc/test/run_*

# Local test media files
*.mkv
*.mov
*.mp4
*.mxf

# Generated app bundles (packaged artifacts)
fpc/gui/form.app/
fpc/gui/ffmpeg_converter_gui.app/

# Generated dylib dependency/queue files and bundled libs (produced by package_macos_app.sh)
src/platform/macos/bin/.deps_ffmpeg7.txt
src/platform/macos/bin/.queue_ffmpeg7.txt
src/platform/macos/bin/lib/

# Object files
*.o
*.obj

# Libraries
*.so
*.dylib
*.dll

# Executables
*.exe
*.out

# macOS metadata
.DS_Store

# Logs and temporary
*.log
*.tmp
*~
*.swp

# IDE/editor
.vscode/
.idea/
/.cache/

# Coverage
coverage/
