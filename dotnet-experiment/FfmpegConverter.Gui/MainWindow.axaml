<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="800"
        Width="1050" Height="800"
        MinWidth="920" MinHeight="660"
        x:Class="FfmpegConverter.Gui.MainWindow"
        Title="FFmpeg Converter"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        DragDrop.AllowDrop="True">

    <Window.Styles>
        <Style Selector="TextBox#LogTextBox">
            <Setter Property="Background" Value="{DynamicResource ConsoleBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ConsoleFgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        </Style>
        <Style Selector="TextBox#LogTextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ConsoleBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        </Style>
        <Style Selector="TextBox#LogTextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource ConsoleBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextAccentBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, Auto, 160" Margin="14">
        <!-- HEADER -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" CornerRadius="5" Padding="14,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="FFmpeg Converter" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextAccentBrush}" />
                    <TextBlock x:Name="PlatformLabel" Text="Platform: Unknown" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="PresetDbLabel" Text="Preset DB: Loading..." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ToolsStatusLabel" Text="Tools: Resolving..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE CONTENT -->
        <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *">
            <!-- 1. THREE UPPER COLUMNS: VIDEO | AUDIO | FILTERS -->
            <Grid Grid.Row="0" ColumnDefinitions="*, *, *" Margin="0,0,0,10">
                <!-- VIDEO COLUMN -->
                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,6,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Video" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextAccentBrush}" Margin="0,0,0,4" />
                        
                        <!-- Codec / Group -->
                        <Grid ColumnDefinitions="70, *">
                            <TextBlock Grid.Column="0" Text="Codec:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="CodecComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30" />
                        </Grid>

                        <!-- Encoder -->
                        <Grid ColumnDefinitions="70, *">
                            <TextBlock Grid.Column="0" Text="Encoder:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="EncoderComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30" />
                        </Grid>

                        <!-- Preset -->
                        <Grid ColumnDefinitions="70, *">
                            <TextBlock Grid.Column="0" Text="Preset:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="PresetComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30" />
                        </Grid>

                        <!-- Vulkan Device (conditional) -->
                        <Grid x:Name="VulkanDevRow" ColumnDefinitions="70, *" IsVisible="False">
                            <TextBlock Grid.Column="0" Text="Vulkan dev:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="11" Foreground="{DynamicResource TextAccentBrush}" />
                            <ComboBox x:Name="VulkanDevComboBox" Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30" />
                        </Grid>

                        <!-- VAAPI Device (conditional) -->
                        <Grid x:Name="VaapiDevRow" ColumnDefinitions="70, *" IsVisible="False">
                            <TextBlock Grid.Column="0" Text="VAAPI dev:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="11" Foreground="{DynamicResource TextAccentBrush}" />
                            <TextBox x:Name="VaapiDevTextBox" Grid.Column="1" PlaceholderText="Auto or /dev/dri/renderD128" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30" VerticalContentAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- AUDIO COLUMN -->
                <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="3,0,3,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Audio" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextAccentBrush}" Margin="0,0,0,4" />

                        <!-- Audio Norm -->
                        <Grid ColumnDefinitions="80, *">
                            <TextBlock Grid.Column="0" Text="Audio norm:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="AudioNormComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30">
                                <ComboBoxItem Content="none" Tag="none" />
                                <ComboBoxItem Content="peak_norm" Tag="peak_norm" />
                                <ComboBoxItem Content="peak_norm_2pass" Tag="peak_norm_2pass" />
                                <ComboBoxItem Content="loudness_norm_2pass" Tag="loudness_norm_2pass" />
                            </ComboBox>
                        </Grid>

                        <!-- Genre (Gated: only loudness_norm_2pass) -->
                        <Grid ColumnDefinitions="80, *">
                            <TextBlock Grid.Column="0" Text="Genre:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="GenreComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30" IsEnabled="False">
                                <ComboBoxItem Content="none" Tag="0" />
                                <ComboBoxItem Content="edm" Tag="1" />
                                <ComboBoxItem Content="rock" Tag="2" />
                                <ComboBoxItem Content="hiphop" Tag="3" />
                                <ComboBoxItem Content="classical" Tag="4" />
                                <ComboBoxItem Content="podcast" Tag="5" />
                            </ComboBox>
                        </Grid>

                        <!-- Audio Output -->
                        <Grid ColumnDefinitions="80, *">
                            <TextBlock Grid.Column="0" Text="Audio out:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="AudioModeComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30">
                                <ComboBoxItem Content="pcm" Tag="pcm" />
                                <ComboBoxItem Content="copy" Tag="copy" />
                                <ComboBoxItem Content="fdk_aac_320" Tag="fdk_aac_320" />
                                <ComboBoxItem Content="fdk_aac_320_ac3_640" Tag="fdk_aac_320_ac3_640" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- FILTERS COLUMN -->
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="6,0,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Filters" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextAccentBrush}" Margin="0,0,0,4" />

                        <!-- Filter -->
                        <Grid ColumnDefinitions="85, *">
                            <TextBlock Grid.Column="0" Text="Filter:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="FilterComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30">
                                <ComboBoxItem Content="none" Tag="none" />
                                <ComboBoxItem Content="weak" Tag="weak" />
                                <ComboBoxItem Content="strong" Tag="strong" />
                            </ComboBox>
                        </Grid>

                        <!-- Filter Preset -->
                        <Grid ColumnDefinitions="85, *">
                            <TextBlock Grid.Column="0" Text="Filter preset:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <ComboBox x:Name="FilterPresetComboBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30">
                                <ComboBoxItem Content="none" Tag="none" />
                                <ComboBoxItem Content="weak" Tag="weak" />
                                <ComboBoxItem Content="strong" Tag="strong" />
                            </ComboBox>
                        </Grid>

                        <TextBlock x:Name="FilterStatusLabel" Text="Deblock filter: active for ProRes software" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 2. CONFIGURATION ROW: OUTPUT DIRECTORY, GENERAL FLAGS & VIDEO TRACK -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                <StackPanel Spacing="8">
                    <!-- Overwrite & Dry Run -->
                    <Grid ColumnDefinitions="*, Auto, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                            <CheckBox x:Name="OverwriteCheckBox" Content="Overwrite existing files" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <CheckBox x:Name="DryRunCheckBox" Content="Dry Run (log commands only)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="HwEncodersSummary" Grid.Column="1" Grid.ColumnSpan="2" Text="Probing hardware encoders..." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Output Directory -->
                    <Grid ColumnDefinitions="80, *, 90">
                        <TextBlock Grid.Column="0" Text="Output dir:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBox x:Name="OutputDirTextBox" Grid.Column="1" PlaceholderText="Default: $HOME/ffmpeg_converter" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="BrowseOutputDirButton" Grid.Column="2" Content="Choose..." Click="OnBrowseOutputDirClick" Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="30" />
                    </Grid>

                    <!-- Replacement Video Track (Mux mode only) -->
                    <Grid x:Name="VideoTrackRow" ColumnDefinitions="80, *, 100, 70" IsVisible="False">
                        <TextBlock Grid.Column="0" Text="Video track:" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextAccentBrush}" FontWeight="SemiBold" />
                        <TextBox x:Name="VideoTrackTextBox" Grid.Column="1" PlaceholderText="Select replacement video track file..." Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource InputFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" Height="30" VerticalContentAlignment="Center" IsReadOnly="True" Margin="0,0,8,0" />
                        <Button x:Name="BrowseVideoTrackButton" Grid.Column="2" Content="Add track..." Click="OnBrowseVideoTrackClick" Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource TextAccentBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="30" Margin="0,0,6,0" />
                        <Button x:Name="ClearVideoTrackButton" Grid.Column="3" Content="Clear" Click="OnClearVideoTrackClick" Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="30" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. FILE QUEUE & ACTION BUTTONS -->
            <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                <DockPanel>
                    <!-- Queue Action Buttons (Top of queue) -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*, *, *, *, *" Margin="0,0,0,8">
                        <Button x:Name="AddFilesButton" Grid.Column="0" Content="Add Files..." Click="OnAddFilesClick" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextAccentBrush}" BorderBrush="{DynamicResource TextAccentBrush}" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="32" Margin="0,0,4,0" />
                        <Button x:Name="AddTrackButton" Grid.Column="1" Content="Add Track..." Click="OnBrowseVideoTrackClick" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="32" Margin="4,0,4,0" />
                        <Button x:Name="AppleM4vButton" Grid.Column="2" Content="Apple m4v..." Click="OnAppleM4vClick" Background="{DynamicResource CardBgBrush}" Foreground="#e67e22" BorderBrush="#e67e22" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="32" Margin="4,0,4,0" />
                        <Button x:Name="RemoveFilesButton" Grid.Column="3" Content="Remove Selected" Click="OnRemoveFilesClick" Background="{DynamicResource CardBgBrush}" Foreground="#e74c3c" BorderBrush="#e74c3c" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="32" Margin="4,0,4,0" />
                        <Button x:Name="ClearFilesButton" Grid.Column="4" Content="Clear List" Click="OnClearFilesClick" Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="32" Margin="4,0,0,0" />
                    </Grid>

                    <!-- ListBox of Queued Files -->
                    <ListBox x:Name="InputFilesListBox" Background="{DynamicResource ListBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- PROGRESS & ACTIONS BAR -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,10,0,10">
            <Grid ColumnDefinitions="*, 280">
                <!-- Progress details -->
                <Grid Grid.Column="0" RowDefinitions="Auto, Auto" Margin="0,0,16,0">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                        <TextBlock x:Name="StatusLabel" Grid.Column="0" Text="Ready." FontSize="13" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="DetailsLabel" Grid.Column="1" Text="" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" />
                    </Grid>
                    <ProgressBar x:Name="FileProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Height="16" HorizontalAlignment="Stretch" Foreground="{DynamicResource TextAccentBrush}" Background="{DynamicResource ProgressBgBrush}" />
                </Grid>

                <!-- Actions -->
                <Grid Grid.Column="1" ColumnDefinitions="*, *">
                    <Button x:Name="StartButton" Grid.Column="0" Content="Start" Click="OnStartConversionClick" Background="{DynamicResource TextAccentBrush}" Foreground="#ffffff" FontWeight="Bold" Height="38" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0" />
                    <Button x:Name="CancelButton" Grid.Column="1" Content="Stop" Click="OnCancelClick" Background="#e74c3c" Foreground="#ffffff" FontWeight="Bold" Height="38" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsEnabled="False" />
                </Grid>
            </Grid>
        </Border>

        <!-- CONSOLE LOG OUTPUT -->
        <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
            <DockPanel>
                <Grid DockPanel.Dock="Top" ColumnDefinitions="*, Auto" Margin="0,0,0,6">
                    <TextBlock Grid.Column="0" Text="Console Output Logs" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Clear Log" Click="OnClearLogClick" FontSize="10" Background="{DynamicResource ButtonSecondaryBgBrush}" Foreground="{DynamicResource ButtonSecondaryFgBrush}" BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" Padding="8,2" Height="22" />
                </Grid>
                <TextBox x:Name="LogTextBox" FontFamily="Consolas,Menlo,Monaco,Courier New,Courier,monospace" FontSize="11" Background="{DynamicResource ConsoleBgBrush}" Foreground="{DynamicResource ConsoleFgBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="6,4" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
