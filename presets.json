  "linux": {
    "copy": {
      "default": {
        "ffmpeg_args": "-c:v copy",
        "container": "mkv"
      }
    },
    "prores": {
      "lt": {
        "ffmpeg_args": "-c:v prores -profile:v 1",
        "container": "mov"
      },
      "standard": {
        "ffmpeg_args": "-c:v prores -profile:v 2",
        "container": "mov"
      },
      "hq": {
