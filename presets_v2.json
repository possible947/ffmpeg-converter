{
  "schema_version": "2.0",
  "description": "FFmpeg Converter unified codec selection catalog",
  "features": {
    "hq_converter": false
  },
  "rules": {
    "missing_enabled_is_false": true,
    "runtime_probe_enabled_components": true,
    "execution_presets_file": "presets.json"
  },
  "selection": {
    "common": {
      "software": {
        "enabled": true,
        "kind": "software_encoder_group",
        "encoders": {
          "prores": {
            "enabled": true,
            "final_codec": "prores",
            "presets_source": {
              "type": "builtin_execution",
              "codec": "prores"
            }
          },
          "prores_ks": {
            "enabled": true,
            "final_codec": "prores_ks",
            "presets_source": {
              "type": "builtin_execution",
              "codec": "prores_ks"
            }
          }
        }
      },
      "mux": {
        "enabled": true,
        "kind": "video_pipeline_group",
        "modes": {
          "copy": {
            "enabled": true,
            "kind": "stream_copy",
            "execution_codec": "copy",
            "presets_source": {
              "type": "builtin_execution",
              "codec": "copy"
            }
          },
          "mux": {
            "enabled": true,
            "kind": "replacement_track",
            "execution_codec": "mux",
            "containers": ["mkv", "mov", "m4v"],
            "presets_source": {
              "type": "builtin_execution",
              "codec": "mux"
            }
          },
          "m4v": {
            "enabled": true,
            "kind": "apple_m4v_pipeline",
            "execution_codec": "m4v",
            "presets_source": {
              "type": "builtin_execution",
              "codec": "m4v"
            }
          }
        }
      },
      "hq_converter": {
        "enabled": false,
        "kind": "external_encoder_group",
        "feature_gate": "hq_converter",
        "encoders_source": {
          "type": "hq_runtime",
          "path": "modules/encoder_orchestrator_v2/config/presets/encoder_presets_v2.json",
          "key": "encoders"
        },
        "presets_source": {
          "type": "hq_runtime",
          "default_preset_key": "default_preset",
          "presets_key": "presets"
        }
      }
    },
    "platforms": {
      "linux": {
        "hwaccel": {
          "enabled": true,
          "groups": {
            "vaapi": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_vaapi",
                  "requires": ["h264_vaapi"],
                  "bit_depths": [8]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_vaapi",
                  "requires": ["hevc_vaapi"],
                  "bit_depths": [8]
                },
                "hevc_10bit": {
                  "enabled": true,
                  "final_codec": "hevc_vaapi",
                  "requires": ["hevc_vaapi_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "profile_args": "-profile:v main10",
                  "presets": ["default", "speed", "balance", "quality"]
                },
                "av1": {
                  "enabled": true,
                  "final_codec": "av1_vaapi",
                  "requires": ["av1_vaapi"],
                  "bit_depths": [8],
                  "presets": ["default", "speed", "balance", "quality"]
                },
                "av1_10bit": {
                  "enabled": true,
                  "final_codec": "av1_vaapi",
                  "requires": ["av1_vaapi_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "presets": ["default", "speed", "balance", "quality"]
                }
              }
            },
            "nvenc": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_nvenc",
                  "requires": ["h264_nvenc"]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_nvenc",
                  "requires": ["hevc_nvenc"]
                },
                "av1": {
                  "enabled": true,
                  "final_codec": "av1_nvenc",
                  "requires": ["av1_nvenc"],
                  "bit_depths": [8],
                  "presets": ["default", "speed", "balance", "quality"]
                },
                "hevc_10bit": {
                  "enabled": true,
                  "final_codec": "hevc_nvenc",
                  "requires": ["hevc_nvenc_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "profile_args": "-profile:v main10",
                  "presets": ["default", "speed", "balance", "quality"]
                },
                "av1_10bit": {
                  "enabled": true,
                  "final_codec": "av1_nvenc",
                  "requires": ["av1_nvenc_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "presets": ["default", "speed", "balance", "quality"]
                }
              }
            },
            "amf": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_amf",
                  "requires": ["h264_amf"]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_amf",
                  "requires": ["hevc_amf"]
                },
                "av1": {
                  "enabled": true,
                  "final_codec": "av1_amf",
                  "requires": ["av1_amf"]
                }
              }
            },
            "qsv": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_qsv",
                  "requires": ["h264_qsv"],
                  "bit_depths": [8]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_qsv",
                  "requires": ["hevc_qsv"],
                  "bit_depths": [8]
                },
                "hevc_10bit": {
                  "enabled": true,
                  "final_codec": "hevc_qsv",
                  "requires": ["hevc_qsv_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "profile_args": "-profile:v main10",
                  "presets": ["default", "speed", "balance", "quality"]
                },
                "av1": {
                  "enabled": true,
                  "final_codec": "av1_qsv",
                  "requires": ["av1_qsv"],
                  "bit_depths": [8],
                  "presets": ["default", "speed", "balance", "quality"]
                },
                "av1_10bit": {
                  "enabled": true,
                  "final_codec": "av1_qsv",
                  "requires": ["av1_qsv_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "presets": ["default", "speed", "balance", "quality"]
                }
              }
            },
            "vulkan": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "prores_ks": {
                  "enabled": true,
                  "final_codec": "prores_ks_vulkan",
                  "requires": ["prores_ks_vulkan"]
                },
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_vulkan",
                  "requires": ["h264_vulkan"]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_vulkan",
                  "requires": ["hevc_vulkan"]
                },
                "av1": {
                  "enabled": true,
                  "final_codec": "av1_vulkan",
                  "requires": ["av1_vulkan"]
                }
              }
            }
          }
        }
      },
      "macos": {
        "hwaccel": {
          "enabled": true,
          "groups": {
            "videotoolbox": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "prores": {
                  "enabled": true,
                  "final_codec": "prores_videotoolbox",
                  "requires": ["prores_videotoolbox"]
                },
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_videotoolbox",
                  "requires": ["h264_videotoolbox"]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_videotoolbox",
                  "requires": ["hevc_videotoolbox"]
                }
              }
            }
          }
        }
      },
      "windows": {
        "hwaccel": {
          "enabled": true,
          "groups": {
            "nvenc": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_nvenc",
                  "requires": ["h264_nvenc"]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_nvenc",
                  "requires": ["hevc_nvenc"]
                },
                "av1": {
                  "enabled": true,
                  "final_codec": "av1_nvenc",
                  "requires": ["av1_nvenc"]
                },
                "hevc_10bit": {
                  "enabled": true,
                  "final_codec": "hevc_nvenc",
                  "requires": ["hevc_nvenc_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "profile_args": "-profile:v main10",
                  "presets": ["default", "speed", "balance", "quality"]
                },
                "av1_10bit": {
                  "enabled": true,
                  "final_codec": "av1_nvenc",
                  "requires": ["av1_nvenc_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "presets": ["default", "speed", "balance", "quality"]
                }
              }
            },
            "amf": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_amf",
                  "requires": ["h264_amf"]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_amf",
                  "requires": ["hevc_amf"]
                },
                "av1": {
                  "enabled": true,
                  "final_codec": "av1_amf",
                  "requires": ["av1_amf"]
                }
              }
            },
            "qsv": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_qsv",
                  "requires": ["h264_qsv"]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_qsv",
                  "requires": ["hevc_qsv"],
                  "bit_depths": [8]
                },
                "av1": {
                  "enabled": true,
                  "final_codec": "av1_qsv",
                  "requires": ["av1_qsv"],
                  "bit_depths": [8]
                },
                "hevc_10bit": {
                  "enabled": true,
                  "final_codec": "hevc_qsv",
                  "requires": ["hevc_qsv_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "profile_args": "-profile:v main10",
                  "presets": ["default", "speed", "balance", "quality"]
                },
                "av1_10bit": {
                  "enabled": true,
                  "final_codec": "av1_qsv",
                  "requires": ["av1_qsv_10bit"],
                  "bit_depths": [10],
                  "pixel_format": "p010le",
                  "presets": ["default", "speed", "balance", "quality"]
                }
              }
            },
            "vulkan": {
              "enabled": true,
              "kind": "hwaccel_encoder_group",
              "encoders": {
                "prores_ks": {
                  "enabled": true,
                  "final_codec": "prores_ks_vulkan",
                  "requires": ["prores_ks_vulkan"]
                },
                "h264": {
                  "enabled": true,
                  "final_codec": "h264_vulkan",
                  "requires": ["h264_vulkan"]
                },
                "hevc": {
                  "enabled": true,
                  "final_codec": "hevc_vulkan",
                  "requires": ["hevc_vulkan"]
                },
                "av1": {
                  "enabled": true,
                  "final_codec": "av1_vulkan",
                  "requires": ["av1_vulkan"]
                }
              }
            }
          }
        }
      }
    }
  },
  "legacy": {
    "accept_flat_codec_ids": true,
    "source": "execution.<platform>.<final_codec>"
  }
}
